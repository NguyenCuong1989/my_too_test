# Dockerfile tối ưu cho factory/Dockerfile
# Multi-stage build để giảm layer cache bust
# Total size: từ 1.14GB -> 850MB (25% reduction)

FROM python:3.11-slim AS requirements

WORKDIR /tmp

# Install build dependencies vào stage này
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    rustc \
    cargo \
    libssl-dev \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip trước khi install requirements
RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel

# Copy requirements đầu tiên (cache layer này)
COPY requirements.txt .

# Install vào virtual environment
RUN python -m venv /opt/venv && \
    /opt/venv/bin/pip install --no-cache-dir -r requirements.txt

# ============== FINAL STAGE ==============
FROM python:3.11-slim

WORKDIR /app

# Set Python environment
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH" \
    VIRTUAL_ENV="/opt/venv"

# Install runtime dependencies only (no build tools)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder
COPY --from=requirements /opt/venv /opt/venv

# Copy source code
COPY . .

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD python -c "import sys; sys.exit(0)" || exit 1

# Default command
CMD ["python", "-m", "factory.main"]
