#!/bin/zsh
# Authority: BỐ CƯỜNG Supreme System Commander

COMMAND=$1

case $COMMAND in
  "start")
    echo "🔥 [OMNI] Activating Omni-API Core..."
    nohup /opt/homebrew/bin/python3.13 /Users/andy/my_too_test/autonomous_operator/omni_api.py > /tmp/omni_api.log 2>&1 &
    sleep 2
    echo "✅ Omni-API launched. Logs: /tmp/omni_api.log"
    ;;
  "heal")
    echo "🛡️ [OMNI] Triggering System Healing..."
    curl -X POST http://localhost:4287/api/system/heal
    ;;
  "status")
    echo "📡 [OMNI] System Status Check..."
    curl -s http://localhost:4287/api/nodes/status
    ;;
  "api")
    echo "🔑 [OMNI] Active Key State:"
    curl -s http://localhost:4287/api/keys/active
    ;;
  *)
    echo "Usage: ./omni [start|heal|status|api]"
    ;;
esac
